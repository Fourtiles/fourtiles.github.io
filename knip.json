{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": ["src/**/*.{ts,vue}"],
  "entry": ["src/**/*.spec.ts"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "error"
  },
  "ignoreDependencies": [
    "@types/setimmediate",
    "@vue/compiler-dom",
    "@vue/server-renderer",
    "@vue/test-utils",
    "postcss",
    "setimmediate"
  ]
}
