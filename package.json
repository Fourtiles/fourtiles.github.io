{
  "name": "fourtiles",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.{css,vue}\" \"public/*.css\"",
    "lint:oxlint": "oxlint -c oxlintrc.json src public",
    "lint:knip": "knip",
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint && pnpm run lint:oxlint && pnpm run lint:knip",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --ui",
    "test:unit": "vitest",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@sentry/vue": "^11.10.0",
    "@tabler/icons-vue": "^3.50.0",
    "@vueuse/core": "^15.0.0",
    "canvas-confetti": "^1.9.4",
    "lodash-es": "^4.18.1",
    "mitt": "^3.0.1",
    "normalize.css": "^8.0.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/vue": "^8.1.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/setimmediate": "^1.0.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-dom": "^3.5.44",
    "@vue/server-renderer": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "setimmediate": "^1.0.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-csp-guard": "^4.0.1",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.16.1"
}
